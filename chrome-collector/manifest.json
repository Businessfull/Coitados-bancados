{
  "manifest_version": 3,
  "name": "Coitados Bancados — Coletor Highscore",
  "version": "1.1.0",
  "description": "Coleta personagens monitorados diretamente do ranking público do DeusOLD no navegador.",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.deusold.com/*",
    "https://deusold.com/*",
    "https://coitados-bancados.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.deusold.com/ranking*",
        "https://deusold.com/ranking*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}